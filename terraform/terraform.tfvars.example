# Example variable values for local runs. Copy to terraform.tfvars and fill in
# your own key pair name — terraform.tfvars is gitignored. In GitHub Actions
# the same values come from -var flags and GitHub Secrets instead.

aws_region       = "us-east-1"
instance_type    = "t3.micro"
key_name         = "CHANGE-ME-your-ec2-keypair-name"
ssh_allowed_cidr = "0.0.0.0/0" # for a throwaway lab only; pin to your IP if possible
