# =============================================================================
# .gitignore — Lab 06: Terraform Workspaces
#
# Terraform state (especially per-workspace state under terraform.tfstate.d/)
# can contain sensitive values and must never be committed. Ansible ignores
# are included so the file is drop-in ready for labs that mix both tools.
# =============================================================================

# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
terraform.tfstate.d/
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ansible
*.retry
.vault_pass
.molecule/
ansible_collections/

# Python (Ansible modules, Molecule, linting helpers)
__pycache__/
*.py[cod]
.venv/
venv/

# Editor and OS junk
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
