# Terraform state artifacts
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfstate.lock.info
crash.log
crash.*.log

# Variable files may contain secrets — never commit them.
# (Negation keeps an example file, if added, tracked.)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Lab output produced by the local_file resource in main.tf
lab-output.txt

# Generated plan files
*.tfplan

# Ansible artifacts (kept for consistency across labs in this repo)
*.retry
.molecule/
.vault_pass

# Python / tooling virtual environments
__pycache__/
.venv/
venv/

# Editor and OS junk
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
