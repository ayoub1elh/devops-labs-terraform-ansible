# .gitignore for lab-10-playbooks (Terraform + Ansible conventions).

# --- Terraform artifacts (kept for consistency across the repo's labs) ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
.terraform.lock.hcl
.terraformrc
terraform.rc

# --- Ansible artifacts ---
*.retry                 # files created when a playbook run fails halfway
.vault_pass             # never commit an Ansible Vault password file
.molecule/              # Molecule test-runner caches
*.vault.yml             # convention for vault-encrypted variable files

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Editor / OS junk ---
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
