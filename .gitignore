# .gitignore — Lab 03 (Terraform)

# Terraform working directory and lock file (rebuilt by `terraform init`)
.terraform/
.terraform.lock.hcl

# Local state — never commit real state files
*.tfstate
*.tfstate.*

# Variable value files may contain secrets; keep an example instead
*.tfvars
!*.tfvars.example

# Crash logs and saved plans
crash.log
crash.*.log
tfplan

# Editor / OS junk
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Python tooling occasionally used with Terraform tooling
__pycache__/
.venv/
