# .gitignore for Lab 11 — Ansible Roles (Terraform entries kept for
# repo-wide consistency; this lab itself is Ansible-only).

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
.terraform.lock.hcl
terraform.tfplan

# --- Ansible ---
*.retry
.vault_pass
.molecule/
.cache/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Editor / OS junk ---
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
