# ─── Terraform ────────────────────────────────────────────────────────────────
# Local .terraform directories and lock files (per-branch/module)
**/.terraform/*
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ─── Ansible ──────────────────────────────────────────────────────────────────
*.retry                # ansible-playbook retry files
.vault_pass            # never commit vault passwords
*.vault_pass
ansible.log

# ─── Molecule / tests ─────────────────────────────────────────────────────────
.molecule/
.pytest_cache/
__pycache__/
*.pyc

# ─── Python (molecule/ansible deps) ───────────────────────────────────────────
.venv/
venv/

# ─── Editors / OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ─── Build staging area (used by repo maintainers) ────────────────────────────
staging/
