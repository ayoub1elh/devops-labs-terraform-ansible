# .gitignore for lab-12 (Molecule testing of the webserver role).
# Covers Terraform artifacts (repo convention), Ansible artifacts,
# Molecule test state, and Python/editor junk.

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
.terraform.lock.hcl
.terraformrc
terraform.rc

# --- Ansible ---
*.retry
.vault_pass
ansible.log

# --- Molecule / test state ---
.molecule/
**/.molecule/

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
