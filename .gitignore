# .gitignore for lab-09-ansible-basics (Terraform + Ansible conventions)

# --- Terraform state and working files (kept for consistency across labs) ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# --- Ansible artifacts ---
*.retry              # leftover retry files from failed playbook runs
.vault_pass          # never commit vault passwords
.molecule/           # molecule test caches
*.vault.yml          # encrypted var files committed by mistake

# --- Python (Ansible is a Python tool) ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Editor / OS junk ---
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
