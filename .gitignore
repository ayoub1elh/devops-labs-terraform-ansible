# .gitignore — Terraform + Ansible labs.
# Cloud credentials, state, retries, virtualenvs and editor/OS junk
# must never be committed.

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
.terraformrc
terraform.rc
.terraform.lock.hcl

# --- Ansible ---
*.retry
.vault_pass
.molecule/
.cache/

# --- Python / tooling ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- Secrets / keys (never commit private keys) ---
*.pem
*.key
id_rsa
id_ed25519

# --- Editor / OS junk ---
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
