# =============================================================================
# lab-15-ansible-vault — .gitignore
# Terraform state and Ansible runtime artifacts are excluded even though
# this lab is Ansible-only, so the file stays correct if reused in a
# combined Terraform+Ansible repo.
# =============================================================================

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
.terraform.lock.hcl
.terraformrc
terraform.rc

# --- Ansible ---
*.retry
.vault_pass
.vault_pass.*
vault_password
*.log

# --- Python / tooling ---
__pycache__/
*.py[cod]
.venv/
venv/
.molecule/
.pytest_cache/

# --- OS / editor junk ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
