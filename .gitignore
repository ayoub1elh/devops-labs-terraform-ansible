# .gitignore — Terraform + Ansible artifacts for Lab 08.

# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable files may contain sensitive values (IPs, account IDs)
*.tfvars
!*.tfvars.example

# Ansible
*.retry
.vault_pass
.molecule/

# Python (ansible/molecule tooling)
__pycache__/
*.pyc
.venv/
venv/

# Editors / OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
