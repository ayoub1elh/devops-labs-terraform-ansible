# Lab 00 — .gitignore (shared across all labs in the series)
#
# Terraform artifacts
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Terraform variables — never commit real variable values; example files are kept.
*.tfvars
!*.tfvars.example

# Terragrunt / misc TF tooling
.terragrunt-cache/
tflint_report.json

# Ansible artifacts
*.retry
.vault_pass
.vault_pass.txt
*.vault.yml
!*.vault.yml.example
ansible.log

# Molecule / testing
.molecule/
.molecule_cache/

# Python (ansible, molecule, checkov are Python-based)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Security / IaC scanning output (generated locally)
checkov_report*
tfsec_results*
.scannerwork/

# Editor / OS junk
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Local env files — never commit secrets
.env
.env.*
!.env.example
